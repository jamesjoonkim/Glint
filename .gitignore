# dependencies
node_modules/
.pnp/
.pnp.js

# build output
out/
dist/
.vite/

# bundled runtime (downloaded/built locally)
resources/runtime/

# PyInstaller intermediates + venv (build/python/build-runtime.sh artifacts)
build/python/.venv/
build/python/build/
build/python/dist/
*.pyc
__pycache__/

# user data (created at runtime in ~/Library/Application Support/Glint/, not
# in the repo). The leading slash anchors these to the repo root so they
# can't accidentally shadow source dirs like src/core/models/.
glint.db
/captures/
/models/
/logs/

# coverage + test artifacts
coverage/
playwright-report/
test-results/

# editor + os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# env
.env
.env.local
resources/icon.iconset/
*.traineddata
/tmp/glint-bundle.log
.diag/

# Claude Code local tooling state — TDD-guard data, scheduled-tasks lock,
# per-machine plugin caches. Not portable, not source.
.claude/
